pipeline {
  agent any

  parameters {
    choice(
      name: 'BUILD_MODE',
      choices: ['production', 'docker', 'dockercloud'],
      description: 'Frontend build mode'
    )
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    NODE_OPTIONS = '--max-old-space-size=8192'
    PNPM_CACHE_DIR = '.pnpm-store'
    BACKEND_DOCKER_NETWORK = 'jeecg_boot'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install') {
      steps {
        script {
          if (isUnix()) {
            sh '''
              corepack enable
              pnpm config set store-dir "${PNPM_CACHE_DIR}"
              pnpm install --frozen-lockfile
            '''
          } else {
            powershell '''
              corepack enable
              pnpm config set store-dir "$env:PNPM_CACHE_DIR"
              pnpm install --frozen-lockfile
            '''
          }
        }
      }
    }

    stage('Build') {
      steps {
        script {
          if (isUnix()) {
            if (params.BUILD_MODE == 'docker') {
              sh 'pnpm run build:docker'
            } else if (params.BUILD_MODE == 'dockercloud') {
              sh 'pnpm run build:dockercloud'
            } else {
              sh 'pnpm run build'
            }
          } else {
            if (params.BUILD_MODE == 'docker') {
              powershell 'pnpm run build:docker'
            } else if (params.BUILD_MODE == 'dockercloud') {
              powershell 'pnpm run build:dockercloud'
            } else {
              powershell 'pnpm run build'
            }
          }
        }
      }
    }

    stage('Deploy') {
      when {
        expression { params.BUILD_MODE == 'docker' || params.BUILD_MODE == 'dockercloud' }
      }
      steps {
        script {
          if (isUnix()) {
            sh '''
              docker network inspect "${BACKEND_DOCKER_NETWORK}" >/dev/null 2>&1 || docker network create "${BACKEND_DOCKER_NETWORK}"
              docker compose -f docker-compose.yml down --remove-orphans || true
              docker compose -f docker-compose.yml up -d --build
            '''
          } else {
            powershell '''
              docker network inspect "$env:BACKEND_DOCKER_NETWORK" *> $null
              if ($LASTEXITCODE -ne 0) {
                docker network create "$env:BACKEND_DOCKER_NETWORK"
              }
              docker compose -f docker-compose.yml down --remove-orphans
              docker compose -f docker-compose.yml up -d --build
            '''
          }
        }
      }
    }

    stage('Archive') {
      steps {
        archiveArtifacts artifacts: 'dist/**', fingerprint: true
      }
    }
  }

  post {
    success {
      echo 'Frontend build completed.'
    }
    failure {
      echo 'Frontend build failed. Check build logs.'
    }
  }
}
