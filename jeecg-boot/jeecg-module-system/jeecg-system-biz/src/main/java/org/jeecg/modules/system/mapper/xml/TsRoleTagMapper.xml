<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.system.mapper.TsRoleTagMapper">

    <select id="selectEnabledRoleTags" resultType="org.jeecg.modules.system.entity.TsRoleTag">
        SELECT id,
               tag_name,
               status,
               sort_no,
               created_at,
               updated_at
        FROM ts_role_tag
        WHERE status = 1
        ORDER BY sort_no ASC, id ASC
    </select>

</mapper>

